# nl2opt 环境变量模板。
# 用法：复制为 .env 后填入真实值（.env 已被 .gitignore 忽略，不会提交）。
#
# 加载方式：src/nl2opt/config.py 的 _env_overrides() 会把下列变量映射到对应配置项，
# 覆盖 config.yaml 中的同名值。

# ── 必填：DeepSeek API Key（LLM 理解 / 重写需要；没有 Key 时只能跑自检与离线注入 IR）
# 获取：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# ── 可选：覆盖 config.yaml 的 llm 段
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-flash

# ── 可选：指定配置文件路径（默认：项目根目录的 config.yaml）
# NL2OPT_CONFIG=config.yaml
